'''
Suponga que se tiene un conjunto de calificaciones de un grupo de 20 alumnos. Realizar un algoritmo para calcular el promedio  y la calificación más alta y  más baja de todo el grupo.  
'''

suma = 0
menor = 100
mayor = 0
cantidad = 0
nota = 0
confirmacion = "si"

while True:
    confirmacion = input("desea ingresar una nota? (si/no): ").lower()
    if confirmacion == "no":
        break
    elif confirmacion != "si":
        print("respuesta no valida, ingrese si o no")
        continue
    nota = float(input(f"ingrese la nota {cantidad+1}: "))
    if nota >100 or nota < 0:
        print("nota no valida, ingrese una nota entre 0 y 100")
        continue
    if nota > mayor:
        mayor = nota
    if nota < menor:
        menor = nota
    suma += nota
    cantidad += 1

while True:
    print("===== MENÚ =====")
    print("1.Mostrar promedio")
    print("2.Mostrar nota mas alta")
    print("3.mostrar nota mas baja")
    print("4.salir")
    print("================")

    opcion = input("Elige una opción (1-4): ").strip()

    if opcion == "1":
        print("promedio: ", suma/cantidad)
    elif opcion == "2":
        print("mayor nota: ", mayor)
    elif opcion == "3":
        print("menor nota: ", menor)
    elif opcion == "4":
        print(">>> Saliendo del programa. ¡Hasta luego!")
        break
    else:
        print(">>> Opción no válida. Intenta de nuevo.\n")
