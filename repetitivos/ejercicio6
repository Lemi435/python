'''
Calcular la cantidad de hombres y mujeres presentes en un salón de clases con un total de n personas.
'''

cantidad = int(input("ingrese la cantidad de estudiantes del salon: "))

mujeres = 0
hombres = 0
otro = 0

for i in range(cantidad):
    genero = input(f"ingrese el genero (f/m/otro) de la persona {i+1}: ")
    if genero == "f":
        mujeres += 1
    elif genero == "m":
        hombres += 1
    else:
        otro += 1

while True:
    print("===== MENÚ =====")
    print("1. ver cantidad de mujeres")
    print("2. ver cantidad de hombres")
    print("3. ver cantidad de otros generos")
    print("4. Salir")
    print("================")

    opcion = input("Elige una opción (1-4): ").strip()

    if opcion == "1":
        print(f">>> Cantidad de mujeres: {mujeres}\n")
    elif opcion == "2":
        print(f">>> Cantidad de hombres: {hombres}\n")
    elif opcion == "3":
        print(f">>> Cantidad de otros géneros: {otro}\n")
    elif opcion == "4":
        print(">>> Saliendo del programa. ¡Hasta luego!")
        break
    else:
        print(">>> Opción no válida. Intenta de nuevo.\n")